# ==========================================
# Authentication Variables (Clerk)
# ==========================================
# You must create an application on Clerk.com to get these keys.
# These keys are required to render the Sign-In UI and decode the session.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ==========================================
# Billetto API Variables
# ==========================================
# Ensure this matches the exact format provided by the Billetto Developers portal.
# Example format: Api-Keypair: <your_key>
# Do NOT include the "Api-Keypair:" text here, just the actual key string.
BILLETTO_API_KEY=your_billetto_api_key
